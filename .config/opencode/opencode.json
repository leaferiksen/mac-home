{
    "$schema": "https://opencode.ai/config.json",
    "model": "ollama/qwen3.8:27b-mtp-large",
    "permissions": [
        { "action": "*", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "agent-tinyfish-ai_*", "resource": "*", "effect": "allow" },
        { "action": "sosumi_*", "resource": "*", "effect": "allow" }
    ],
    "experimental": { "policies": [ { "action": "provider.use", "resource": "opencode", "effect": "deny" } ] },
    "providers": {
        "ollama": {
            "name": "Tailnet",
            "package": "aisdk:@ai-sdk/openai-compatible",
            "settings": { "baseURL": "http://100.112.227.27:11434/v1" },
            "models": {
                "qwen3.8:27b-mtp-large": {
                    "name": "Qwen 3.8",
                    "limit": { "context": 65536, "output": 32000 }
                }
            }
        }
    },
    "mcp": {
        "servers": {
            "agent-tinyfish-ai": { "type": "remote", "url": "https://agent.tinyfish.ai/mcp", "disabled": false },
            "sosumi": { "type": "remote", "url": "https://sosumi.ai/mcp", "disabled": false },
            "safari-mcp": { "type": "local", "command": ["/usr/bin/safaridriver", "--mcp"], "disabled": false }
        }
    }
}
