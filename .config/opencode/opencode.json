{
    "$schema": "https://opencode.ai/config.json",
    "command": {
        "question": {
            "template": "Avoid headers/bold for short answers and prefer prose over bullet lists unless enumerating something.",
            "description": "Question answering etiquette",
            "agent": "plan"
        }
    },
    "model": "ollama/qwen3.8:27b-mtp-large",
    "permission": {
        "*": "ask",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "webfetch": "allow",
        "question": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "agent-tinyfish-ai_*": "allow",
        "sosumi_*": "allow"
    },
    "disabled_providers": ["opencode"],
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Tailnet",
            "options": {
                "baseURL": "http://100.112.227.27:11434/v1"
            },
            "models": {
                "qwen3.8:27b-mtp-large": {
                    "name": "Qwen 3.8",
                    "limit": {
                        "context": 65536,
                        "output": 32000
                    }
                }
            }
        }
    },
    "mcp": {
        "agent-tinyfish-ai": {
            "type": "remote",
            "url": "https://agent.tinyfish.ai/mcp",
            "enabled": true
        },
        "sosumi": {
            "type": "remote",
            "url": "https://sosumi.ai/mcp",
            "enabled": true
        },
        "safari-mcp": {
            "type": "local",
            "command": ["/usr/bin/safaridriver", "--mcp"],
            "enabled": true
        }
    },
    "plugin": ["opencode-bash-guard-plugin"]
}
