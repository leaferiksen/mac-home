{:applications {:emacs ["^org\\.gnu\\.Emacs$"]}
 :main [{:des "Right 􀆔 as Right 􀆍, C-h as backspace, and global Emacs bindings"
	 :rules [[:##right_command :left_control] [:!T##semicolon :tab]  [:!T##comma :return_or_enter] [:!T##j :delete_or_backspace]
		 [:!T##3 :up_arrow :!emacs]  [:!T##o :down_arrow :!emacs]  [:!T##2 :right_arrow :!emacs]  [:!T##f :left_arrow :!emacs]]}
	{:des "Toggle dark mode with 􀆪D"
	 :rules [[:!Fr "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to not dark mode'"]]}
	{:des "Colemak Curl/Angle/Extra Wide"
	 :rules [;; left hand
		 [:##tab :q]        [:##q :w]  [:##w :f]  [:##e :p]  [:##r :g]
		 [:##caps_lock :a]  [:##a :r]  [:##s :s]  [:##d :t]  [:##f :d]
		 [:##left_shift :z] [:##z :x]  [:##x :c]  [:##c :v]  [:##v :b]
		 ;; right hand
		 [:##u :j]  [:##i :l]      [:##o :u]           [:##p :y]          [:##open_bracket :semicolon]  [:##close_bracket :quote]
		 [:##j :h]  [:##k :n]      [:##l :e]           [:##semicolon :i]  [:##quote :o]                 [:##return_or_enter :right_shift]
		 [:##m :k]  [:##comma :m]  [:##period :comma]  [:##slash :period] [:##right_shift :slash]
		 ;; numpad
		 [:##t :vk_none]       [:##y :vk_none]
		 [:##g :vk_none]       [:##h :vk_none]
		 [:##b :open_bracket]  [:##n :close_bracket]
		 ;; special
		 [:right_option :f19]  [:!Cright_option :f20]]}]}

;; the rule [:!Ca :!T1] means from command a to control 1
;; :!Ca is keycode :a and prefix a with !C

;; !  | means mandatory
;; #  | means optional
;; C  | left_command
;; T  | left_control
;; O  | left_option
;; S  | left_shift
;; F  | fn (broken)
;; Q  | right_command
;; W  | right_control
;; E  | right_option
;; R  | right_shift
;; P  | caps_lock
;; !! | mandatory command + control + optional + shift (hyper)
;; ## | optional any

;; !CTSequal_sign  | mandatory command control shift =
;;                 | which is command control +
;; !O#Sright_arrow | mandatory option optional left shift right_arrow

;; karabiner definition of mandatory and optional
;; https://karabiner-elements.pqrs.org/docs/json/complex-modifications-manipulator-definition/from/modifiers/

;; rule [<from> <to>]
;; if simplified modifier is used in <to>, optional(#) definition will be
;; ignored.
